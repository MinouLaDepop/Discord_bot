# Copie ce fichier en ".env" et remplis les valeurs.

# Token du bot (portail développeur Discord > Bot > Reset Token)
DISCORD_TOKEN=

# ID de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant)
GUILD_ID=

# --- Lien avec Roblox ---
# Clé secrète partagée entre le bot et ton jeu Roblox (invente une longue chaîne aléatoire)
API_KEY=
# Port sur lequel le bot écoute les requêtes de ton jeu
API_PORT=8080
# ID de l'univers de ton jeu (Roblox Studio > Fichier > Paramètres du jeu > Informations de base)
ROBLOX_UNIVERSE_ID=

# Texte affiché dans le statut du bot
BOT_STATUS=Hatch a Mutant
